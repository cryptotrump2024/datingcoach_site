# Copy to .env.local and fill in. Mirror these in Vercel project settings.

# Supabase (https://supabase.com → Project → Settings → API)
# Leave both empty to run in local-first mode (no account sync).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Postgres connection string — only used by `node scripts/apply-schema.mjs`
# (Supabase → Settings → Database → Connection string)
SUPABASE_DB_URL=

# Server-only Supabase secret key (future server functions). Never VITE_-prefix.
SUPABASE_SECRET_KEY=

# Anthropic API key (https://console.anthropic.com) — enables the live AI
# conversation engine + vision profile analysis via /api functions.
# Leave empty to use the built-in offline practice engine.
ANTHROPIC_API_KEY=

# Optional model overrides
# ANTHROPIC_CHAT_MODEL=claude-haiku-4-5
# ANTHROPIC_ANALYSIS_MODEL=claude-sonnet-4-6
