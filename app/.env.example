# Copy to .env.local and fill in. Mirror server values in Vercel project settings.

# ── Supabase (public, client-safe — also committed in .env.production) ──────
# Leave both empty to run in local-first mode (no account sync).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Postgres connection string — only used by `npm run apply-schema` (server-only)
# (Supabase → Settings → Database → Connection string)
SUPABASE_DB_URL=
# Supabase secret key — server-only (webhook plan updates bypass RLS). Never expose.
SUPABASE_SECRET_KEY=

# ── AI engine (server-only) ────────────────────────────────────────────────
# Configure either or both. Without any, the app uses the offline practice engine.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Which provider to try first: "anthropic" or "openrouter"
AI_PRIMARY=anthropic
# Optional model overrides
# ANTHROPIC_CHAT_MODEL=claude-haiku-4-5
# ANTHROPIC_ANALYSIS_MODEL=claude-sonnet-4-6
# OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
# OPENROUTER_ANALYSIS_MODEL=openai/gpt-4o-mini

# ── Stripe (server-only) ───────────────────────────────────────────────────
# Without these, the Pricing page uses a demo upgrade flow.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
